# ===== 服务 =====
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# ===== 数据 =====
DATA_DIR=./data

# 主密钥：用于 AES-256-GCM 加密上游 Key、签发会话、API Key 查找哈希。
# 不配置时自动生成并保存在 DATA_DIR/master.key，生产环境建议显式配置并妥善保管。
# MASTER_SECRET=change-me-to-a-long-random-string

# ===== 首任管理员（仅首次初始化时生效）=====
BOOTSTRAP_ADMIN_EMAIL=admin@corp.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_NAME=平台管理员

# ===== 运行限制 =====
MAX_CONCURRENT_REQUESTS=5000
TRUST_PROXY=false
LOG_LEVEL=info
DEMO_MODE=false

# /metrics 保护（不设置则仅允许本机访问）
# METRICS_USER=metrics
# METRICS_PASSWORD=change-me

# 允许浏览器跨域调用 /v1 的来源，逗号分隔；默认仅同源
# CORS_ORIGINS=https://app.example.com
